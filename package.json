  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "plannotator",
    "plan-review",
    "cordis"
  ],
  "license": "MIT OR Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/eightHundreds/dsh-plannotator.git"
  },
  "homepage": "https://github.com/eightHundreds/dsh-plannotator",
  "bugs": {
    "url": "https://github.com/eightHundreds/dsh-plannotator/issues"
  },
  "engines": {
    "node": ">=18"
  },
  "dsh": {
