{
  "name": "dsh-plannotator",
  "version": "0.2.0",
  "description": "Opens the official Plannotator app to review the agent's plan — annotate, approve, or send it back.",
  "type": "module",
  "main": "index.js",
  "files": [
    "index.js",
    "lib",
    "skills",
    "cordis.patch.yml",
    "README.md",
    "README.zh.md",
    "LICENSE"
  ],
  "scripts": {
