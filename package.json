      "patch": "./cordis.patch.yml"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4.0.0-rc.0 <5",
    "@deepseek-ai/dsh-llm": ">=0.0.1-rc.0 <1",
    "@deepseek-ai/dsh-plan-mode": ">=0.0.1-rc.0 <1",
    "@deepseek-ai/dsh-skill": "*",
    "@deepseek-ai/dsh-tools": ">=0.0.1-rc.0 <1"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-llm": {
